<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" viewBox="0 0 128 128">

  <!-- Outer border ring -->
  <circle cx="64" cy="64" r="62" fill="none" stroke="white" stroke-width="2.5"/>

  <!-- Radar rings -->
  <circle cx="64" cy="64" r="18" fill="none" stroke="white" stroke-width="0.8" opacity="0.3"/>
  <circle cx="64" cy="64" r="29" fill="none" stroke="white" stroke-width="0.8" opacity="0.2"/>
  <circle cx="64" cy="64" r="50" fill="none" stroke="white" stroke-width="1.5"/>

  <!-- 7 spokes -->
  <line x1="64" y1="64" x2="64"  y2="14"  stroke="white" stroke-width="0.8" opacity="0.3"/>
  <line x1="64" y1="64" x2="102" y2="33"  stroke="white" stroke-width="0.8" opacity="0.3"/>
  <line x1="64" y1="64" x2="111" y2="76"  stroke="white" stroke-width="0.8" opacity="0.3"/>
  <line x1="64" y1="64" x2="90"  y2="107" stroke="white" stroke-width="0.8" opacity="0.3"/>
  <line x1="64" y1="64" x2="38"  y2="107" stroke="white" stroke-width="0.8" opacity="0.3"/>
  <line x1="64" y1="64" x2="17"  y2="76"  stroke="white" stroke-width="0.8" opacity="0.3"/>
  <line x1="64" y1="64" x2="26"  y2="33"  stroke="white" stroke-width="0.8" opacity="0.3"/>

  <!-- Radar polygon -->
  <polygon
    points="64,21 99,38 107,73 87,103 41,103 21,73 29,38"
    fill="white" fill-opacity="0.12" stroke="white" stroke-width="1.5" stroke-linejoin="round"/>

  <!-- Endpoint dots -->
  <circle cx="64"  cy="14"  r="3.5" fill="white"/>
  <circle cx="102" cy="33"  r="3.5" fill="white"/>
  <circle cx="111" cy="76"  r="3.5" fill="white"/>
  <circle cx="90"  cy="107" r="3.5" fill="white"/>
  <circle cx="38"  cy="107" r="3.5" fill="white"/>
  <circle cx="17"  cy="76"  r="3.5" fill="white"/>
  <circle cx="26"  cy="33"  r="3.5" fill="white"/>

  <!-- Center dot -->
  <circle cx="64" cy="64" r="6" fill="white"/>
  <circle cx="64" cy="64" r="2.5" fill="none" stroke="white" stroke-width="1" opacity="0.4"/>

</svg>
